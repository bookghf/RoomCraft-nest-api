# Copy to .env for `npm run dev` / `npm run seed`. On Vercel, set these in Project Settings → Environment Variables.
PORT=8080
MONGO_URI=mongodb://localhost:27017
MONGO_DB=roomcraft

# SmartWorld JWT (HS256). Required unless AUTH_DEV=true.
JWT_SECRET=
JWT_ISSUER=

# Local development only: trust the X-Dev-User header (never on /v1/admin). Never enable in production.
AUTH_DEV=true

# Only used by `npm start` (long-running server). On Vercel run `npm run seed` once instead.
SEED_ON_START=true
CORS_ORIGINS=http://localhost:3000,https://roomcraft-sable.vercel.app
SHARE_BASE_URL=http://localhost:3000
# 0 = share links never expire
SHARE_TTL_DAYS=0
# Per user (or IP), per instance (per warm function on Vercel)
WRITES_PER_MINUTE=60

# Back office. Staff tokens are signed with this; at least 32 characters.
ADMIN_JWT_SECRET=local-dev-only-backoffice-secret-change-me
ADMIN_TOKEN_TTL_HOURS=8
# First owner account, created only when there are no staff yet. Must change the password at first sign-in.
ADMIN_EMAIL=owner@roomcraft.local
ADMIN_PASSWORD=ChangeMe-2026!
