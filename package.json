{
  "name": "roomcraft-api-nest",
  "version": "1.0.0",
  "private": true,
  "description": "RoomCraft designer API (NestJS + MongoDB). Same routes and responses as the Go API.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "npm run build && node --env-file-if-exists=.env dist/main.js",
    "seed": "node --env-file-if-exists=.env dist/scripts/seed.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/"
  },
  "dependencies": {
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "bcryptjs": "3.0.3",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.3",
    "mongodb": "6.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
